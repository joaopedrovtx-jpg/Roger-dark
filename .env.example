# ═══════════════════════════════════════════════════════════
# DarkPay — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite .env real.
# ═══════════════════════════════════════════════════════════

NEXT_PUBLIC_DARKPAY_DATA_MODE=http
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# NEXT_PUBLIC_DARKPAY_API_BASE=/api/v1

# ── Banco ────────────────────────────────────────────────
# Local SQLite (dev):
DATABASE_URL="file:./dev.db"
# Produção MySQL:
# DATABASE_URL=mysql://user:senha@host:3306/darkpay

# ── Sessão / cookies (OBRIGATÓRIO) ───────────────────────
# Gere: openssl rand -hex 32
SESSION_SECRET=change-me-use-openssl-rand-hex-32-chars-min
# FORCE_INSECURE_COOKIE=1   # só localhost http
# COOKIE_SECURE=1           # força Secure em HTTPS

# ── Segurança ────────────────────────────────────────────
# CSRF ativo por padrão; CSRF_STRICT=0 desliga (não recomendado)
# CSRF_ALLOW_MISSING_ORIGIN=1
# Obrigatório atrás de nginx/aaPanel (IP real + rate limit):
TRUST_PROXY=1
# HEALTH_DETAIL_KEY=...     # libera posture em GET /api/health?key=
# REQUIRE_ADMIN_2FA=1       # força 2FA admin (default em production)
# REQUIRE_ADMIN_2FA=0
# ALLOW_PUBLIC_REGISTER=0   # desliga registro público em prod
# API_KEYS_LIVE=1           # gera pk_live_ em dev (default: pk_test_)
# NUNCA em produção:
# ALLOW_MOCK_DATA=1
# ALLOW_UNSIGNED_WEBHOOKS=1
# VELANA_ALLOW_UNSIGNED_WEBHOOK=1

# ── PodPay (HMAC OBRIGATÓRIO) ────────────────────────────
PODPAY_API_KEY=
PODPAY_ENV=sandbox
# PODPAY_POSTBACK_BASE_URL=https://seu-dominio.com
PODPAY_WEBHOOK_SECRET=

# ── Velana (HMAC OBRIGATÓRIO) ────────────────────────────
# Preferível salvar pk_/sk_ no Admin → Credenciais
# VELANA_SECRET_KEY=
# VELANA_PUBLIC_KEY=
# VELANA_POSTBACK_BASE_URL=https://seu-dominio.com
VELANA_WEBHOOK_SECRET=

# ── Woovi ────────────────────────────────────────────────
# Auth: Authorization: SEU_APPID_AQUI  (sem pk_/sk_)
# Preferível salvar AppID no Admin → Adquirentes → Credenciais → Woovi
# AppID: app.woovi.com → API/Plugins → Nova API
# WOOVI_APP_ID=
# WOOVI_ENV=live
# WOOVI_BASE_URL=https://api.woovi.com
# WOOVI_POSTBACK_BASE_URL=https://seu-dominio.com
# Webhook: POST https://seu-dominio.com/api/v1/webhooks/woovi
# Opcional: se setado, exige header Authorization igual ao secret.
# Sem secret: webhook aceito, mas reconfirma status na API antes de creditar.
# WOOVI_WEBHOOK_SECRET=
# WOOVI_ALLOW_UNSIGNED_WEBHOOK=1  # só dev

# ── Turnstile (Cloudflare) — anti-bot (login/registro) ───
# Dashboard: https://dash.cloudflare.com → Turnstile → Add widget
# Hostname: darkpays.online (e www se usar)
# As DUAS keys são obrigatórias para o captcha ligar (evita captcha cosmético).
# Site key também é exposta em GET /api/v1/public/turnstile (sem rebuild).
# Hosts extras (CSV): TURNSTILE_ALLOWED_HOSTNAMES=darkpays.online,www.darkpays.online
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=   # alias legado (lido em runtime se NEXT_PUBLIC_* vazio)
# TURNSTILE_ALLOWED_HOSTNAMES=darkpays.online,www.darkpays.online

# ── E-mail (redefinição de senha / welcome) ──────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=DarkPay <noreply@seu-dominio.com>
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# APP_URL=https://seu-dominio.com

# ── UploadThing (file uploads) ────────────────────────────
# UPLOADTHING_SECRET=sk_...
# UPLOADTHING_APP_ID=...

# ── Logging ──────────────────────────────────────────────
# LOG_LEVEL=info

# ── Seed (só dev; bloqueado em production) ───────────────
SEED_PASSWORD=
